{
  "name": "z-voting-v2",
  "version": "2.0.0",
  "description": "Zero-Knowledge Anonymous Voting Framework - v2 Complete Redesign",
  "private": true,
  "workspaces": [
    "packages/backend",
    "packages/frontend",
    "packages/contracts",
    "packages/circuits"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "dev:backend": "npm --prefix packages/backend run dev",
    "dev:frontend": "npm --prefix packages/frontend run dev",
    "dev:contracts": "npm --prefix packages/contracts run dev",
    "build:all": "npm-run-all build:*",
    "build:backend": "npm --prefix packages/backend run build",
    "build:frontend": "npm --prefix packages/frontend run build",
    "build:contracts": "npm --prefix packages/contracts run build",
    "build:circuits": "npm --prefix packages/circuits run build",
    "test": "npm-run-all test:*",
    "test:backend": "npm --prefix packages/backend run test",
    "test:frontend": "npm --prefix packages/frontend run test",
    "test:contracts": "npm --prefix packages/contracts run test",
    "lint": "npm-run-all lint:*",
    "lint:backend": "npm --prefix packages/backend run lint",
    "lint:frontend": "npm --prefix packages/frontend run lint",
    "format": "npm-run-all format:*",
    "format:backend": "npm --prefix packages/backend run format",
    "format:frontend": "npm --prefix packages/frontend run format",
    "deploy:testnet": "npm --prefix packages/contracts run deploy:testnet",
    "deploy:mainnet": "npm --prefix packages/contracts run deploy:mainnet"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
