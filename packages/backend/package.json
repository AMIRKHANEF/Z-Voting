    "pino-pretty": "^10.3.1"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.10.6",
    "@types/express": "^4.17.21",
    "tsx": "^4.7.0",
    "vitest": "^1.1.1",
    "eslint": "^8.56.0",
